{
    "layer": "top",
    "position": "top",
    "modules-left": ["custom/archbutton", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["cava", "wireplumber", "network", "tray", "custom/dunst", "custom/power"],

    // left modules
    "custom/archbutton": {
        "format": " 󰣇 ",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "all-outputs": false,
        "format-icons": {
          "active": "",
          "urgent": "",
          "default": "",
        },
        "icon-size": 14,
    },

    "hyprland/window": {
        "format": "{title}",
        "rewrite": {
            "(.*) — Zen Browser.*": " $1",
            "Zen Browser": " New Tab",
            "ghostty": "󱙝 Ghostty",
            "Volume Control": "󰗅 Volume Mixer",
            "^$": "Desktop"
        }
    },

    // Middle modules
    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#f5c2e7'>{}</span>",
                "days": "<span color='#ecc6d9'>{}</span>",
                "weekdays": "<span color='#ffcc66'>{}</span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // Right modules
    "cava": {
        "cava_config": "$XDG_CONFIG_HOME/cava/config",
        "framerate": 60,
        "autosens": 1,
        "overshoot": 0,
        "bars": 12,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "reverse": false,
        "bar_delimiter": 0,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.77,
        "input_delay": 2,
        "format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "actions": {
            "on-click-right": "mode"
        },
        "hide_on_silence": true
    },
    "wireplumber": {
        "format": " {volume}%",
        "format-muted": " {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5.0,
    },

    "network": {
        "format": "{ifname}",
        "format-wifi": " 󰤨 ",
        "format-ethernet": " 󰈀 ",
        "format-disconnected": " 󰤮 ",
        "tooltip-format-wifi": "Connected to {essid}",
        "tooltip-format-ethernet": "Connected at {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "custom/dunst": {
        "exec": "~/.config/waybar/scripts/dunst.sh",
        "on-click": "dunstctl set-paused toggle",
        "restart-interval": 1,
        "tooltip": false
    },

    "custom/power": {
        "format": "󰐥",
        "on-click": "~/.config/waybar/scripts/power.sh",
        "tooltip": false
    },
}
